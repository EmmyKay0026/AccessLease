# Test wallets only. Never use real funds, keys, or personally identifiable data.
# Trusted issuer is the ROOT OF TRUST for every authorization decision.
ARKIV_ISSUER_ADDRESS=0x0000000000000000000000000000000000000000
# Admin key is needed only for CLI publishing. NEVER prefix it NEXT_PUBLIC_.
ARKIV_ISSUER_PRIVATE_KEY=
# Optional separate test wallet to demonstrate forged leases.
ARKIV_ATTACKER_PRIVATE_KEY=
# Optional. Keep keyed URLs on the server; omit to use public rate-limited RPC.
ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
# Optional live showcase keys (not secrets):
SAMPLE_VALID_LEASE_KEY=
SAMPLE_FORGED_LEASE_KEY=

# Authentication: shared storage is required in every environment (no memory fallback).
# Production must use the exact HTTPS browser origin; local dev may infer loopback.
ACCESSLEASE_ORIGIN=http://localhost:3000
UPSTASH_REDIS_REST_URL=
# Writable REST token; server only. Never use NEXT_PUBLIC_ for this or RPC credentials.
UPSTASH_REDIS_REST_TOKEN=
